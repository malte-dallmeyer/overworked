{
  // Thin wrappers around scripts/ (run any script with --help for details).
  // Test tasks always start in watch mode. Background matchers tell VS Code when a
  // (re)run has finished; failing tests show up in the Problems panel.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend starten",
      "type": "shell",
      "command": "./scripts/dev-backend.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-uvicorn",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes|Reloading",
          "endsPattern": "Application startup complete|Address already in use"
        }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Frontend starten",
      "type": "shell",
      "command": "./scripts/dev-frontend.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activeOnStart": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Backend + Frontend starten",
      "dependsOn": ["Backend starten", "Frontend starten"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend Unit-Tests",
      "type": "shell",
      "command": "./scripts/test-backend.sh unit --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-pytest-unit",
        "fileLocation": ["relative", "${workspaceFolder}/backend"],
        "pattern": { "regexp": "^FAILED ([^:\\s]+)::(\\S+)", "file": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "test session starts",
          "endsPattern": "^=+ .* in [\\d.]+s"
        }
      },
      "group": "test",
      "presentation": { "group": "tests", "panel": "dedicated" }
    },
    {
      "label": "Backend Integrationstests",
      "type": "shell",
      "command": "./scripts/test-backend.sh integration --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-pytest-integration",
        "fileLocation": ["relative", "${workspaceFolder}/backend"],
        "pattern": { "regexp": "^FAILED ([^:\\s]+)::(\\S+)", "file": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "test session starts",
          "endsPattern": "^=+ .* in [\\d.]+s"
        }
      },
      "group": "test",
      "presentation": { "group": "tests", "panel": "dedicated" }
    },
    {
      "label": "Frontend Unit-Tests",
      "type": "shell",
      "command": "./scripts/test-frontend.sh unit --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-vitest-unit",
        "fileLocation": ["relative", "${workspaceFolder}/frontend"],
        "pattern": { "regexp": "FAIL\\s+.*?(src/\\S+)\\s+>\\s+(.*)$", "file": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\b(DEV|RUN|RERUN)\\b",
          "endsPattern": "Duration|Waiting for file changes"
        }
      },
      "group": "test",
      "presentation": { "group": "tests", "panel": "dedicated" }
    },
    {
      "label": "React Component-Tests",
      "type": "shell",
      "command": "./scripts/test-frontend.sh component --ui ${input:componentBrowser}",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-vitest-component",
        "fileLocation": ["relative", "${workspaceFolder}/frontend"],
        "pattern": { "regexp": "FAIL\\s+.*?(src/\\S+)\\s+>\\s+(.*)$", "file": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\b(DEV|RUN|RERUN)\\b",
          "endsPattern": "Duration|Waiting for file changes"
        }
      },
      "group": "test",
      "presentation": { "group": "tests", "panel": "dedicated" }
    },
    {
      "label": "E2E-Tests",
      "type": "shell",
      "command": "./scripts/test-e2e.sh ${input:e2eMode}",
      "isBackground": true,
      "problemMatcher": {
        "owner": "overworked-playwright",
        "fileLocation": ["relative", "${workspaceFolder}/e2e"],
        "pattern": {
          "regexp": "^\\s+\\d+\\) \\[\\w+\\] › (\\S+?):(\\d+):(\\d+) › (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running \\d+ test",
          "endsPattern": "Warte auf Änderungen|Listening on"
        }
      },
      "group": "test",
      "presentation": { "group": "tests", "panel": "dedicated" }
    },
    {
      "label": "Alle Tests",
      "dependsOn": [
        "Backend Unit-Tests",
        "Backend Integrationstests",
        "Frontend Unit-Tests",
        "React Component-Tests",
        "E2E-Tests"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ],
  "inputs": [
    {
      "id": "componentBrowser",
      "type": "pickString",
      "description": "Browser für die React Component-Tests",
      "options": [
        { "label": "headless, mit Live-Report (Vitest UI)", "value": "" },
        { "label": "headed: Browserfenster mit Vitest-Oberfläche (nicht im Dev Container)", "value": "--headed" }
      ],
      "default": ""
    },
    {
      "id": "e2eMode",
      "type": "pickString",
      "description": "Modus für die E2E-Tests (alle mit Watch)",
      "options": [
        { "label": "headless, mit Report und Trace Viewer (http://localhost:9324)", "value": "--watch" },
        { "label": "headed (sichtbares Browserfenster, nicht im Dev Container)", "value": "--watch --headed" },
        { "label": "Playwright UI-Modus (http://localhost:9323)", "value": "--ui" }
      ],
      "default": "--watch"
    }
  ]
}
