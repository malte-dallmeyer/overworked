{
  "name": "Overworked",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // Lets you run `docker compose build` from inside the container, using the host's Docker.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {
    // Keep the container's virtualenv out of the bind-mounted workspace so it never
    // clashes with a .venv created on the host.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/overworked",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 5173, 9323],
  "portsAttributes": {
    "8000": { "label": "Backend" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" },
    "9323": { "label": "Playwright UI", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "vitest.explorer",
        "ms-playwright.playwright",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/overworked/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/backend",
        "python.testing.pytestArgs": ["tests"],
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
