{
  "openapi": "3.1.0",
  "info": {
    "title": "Overworked",
    "version": "0.1.0"
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Login",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Wrong password"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current": {
      "get": {
        "summary": "Get Current Session",
        "operationId": "get_current_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SessionOut"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Current Session"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/events": {
      "get": {
        "summary": "Stream Session",
        "description": "Server-sent events: the current session (as from GET /session/current) right away and\nwhenever it changes, from any device or the alarm. Commands stay plain requests.",
        "operationId": "stream_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/targets": {
      "get": {
        "summary": "Get Quick Targets",
        "description": "Quick choices for the target on the start screen.",
        "operationId": "get_quick_targets",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuickTargetsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "summary": "Start Session",
        "operationId": "start_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/pause": {
      "post": {
        "summary": "Pause Session",
        "operationId": "pause_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/resume": {
      "post": {
        "summary": "Resume Session",
        "operationId": "resume_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/end": {
      "post": {
        "summary": "End Session",
        "operationId": "end_session",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/target": {
      "put": {
        "summary": "Change Target",
        "description": "Adjusts the remaining time. Extending after the alarm is allowed; the app warns first.",
        "operationId": "change_target",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeTarget"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/snooze": {
      "post": {
        "summary": "Snooze Session",
        "description": "The one snooze: the alarm comes back in 10 minutes.",
        "operationId": "snooze_session",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "409": {
            "description": "Not due or used"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/alarm/{token}/end": {
      "post": {
        "summary": "End Session From Notification",
        "description": "Also fine if the session has ended already: the notification just goes away.",
        "operationId": "end_session_from_notification",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/alarm/{token}/snooze": {
      "post": {
        "summary": "Snooze Session From Notification",
        "operationId": "snooze_session_from_notification",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "description": "Not due or used"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/pauses": {
      "post": {
        "summary": "Add Pause",
        "description": "Adds a pause with start and end: forgotten earlier or planned ahead.",
        "operationId": "add_pause",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/current/pauses/{pause_id}": {
      "put": {
        "summary": "Change Pause",
        "operationId": "change_pause",
        "parameters": [
          {
            "name": "pause_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Pause Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove Pause",
        "operationId": "remove_pause",
        "parameters": [
          {
            "name": "pause_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Pause Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/key": {
      "get": {
        "summary": "Get Push Key",
        "operationId": "get_push_key",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushKeyOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/subscriptions": {
      "post": {
        "summary": "Subscribe Push",
        "description": "Idempotent: a browser that subscribes again just updates its keys.",
        "operationId": "subscribe_push",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unsubscribe Push",
        "operationId": "unsubscribe_push",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushEndpoint"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeTarget": {
        "properties": {
          "target_minutes": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Target Minutes"
          }
        },
        "type": "object",
        "required": [
          "target_minutes"
        ],
        "title": "ChangeTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LegalBreakOut": {
        "properties": {
          "after_minutes": {
            "type": "integer",
            "title": "After Minutes",
            "description": "Applies to targets longer than this."
          },
          "break_minutes": {
            "type": "integer",
            "title": "Break Minutes"
          }
        },
        "type": "object",
        "required": [
          "after_minutes",
          "break_minutes"
        ],
        "title": "LegalBreakOut"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginIn"
      },
      "PauseIn": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ended At"
          }
        },
        "type": "object",
        "required": [
          "started_at",
          "ended_at"
        ],
        "title": "PauseIn"
      },
      "PauseOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At",
            "description": "None while a spontaneous pause is running."
          }
        },
        "type": "object",
        "required": [
          "id",
          "started_at",
          "ended_at"
        ],
        "title": "PauseOut"
      },
      "PushEndpoint": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 1000,
            "title": "Endpoint"
          }
        },
        "type": "object",
        "required": [
          "endpoint"
        ],
        "title": "PushEndpoint"
      },
      "PushKeyOut": {
        "properties": {
          "public_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Key",
            "description": "VAPID key for PushManager.subscribe(); null: off."
          }
        },
        "type": "object",
        "required": [
          "public_key"
        ],
        "title": "PushKeyOut"
      },
      "PushKeys": {
        "properties": {
          "p256dh": {
            "type": "string",
            "maxLength": 200,
            "title": "P256Dh"
          },
          "auth": {
            "type": "string",
            "maxLength": 100,
            "title": "Auth"
          }
        },
        "type": "object",
        "required": [
          "p256dh",
          "auth"
        ],
        "title": "PushKeys"
      },
      "PushSubscriptionIn": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 1000,
            "title": "Endpoint"
          },
          "keys": {
            "$ref": "#/components/schemas/PushKeys"
          }
        },
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "title": "PushSubscriptionIn",
        "description": "As PushSubscription.toJSON() in the browser."
      },
      "QuickTargetsOut": {
        "properties": {
          "last": {
            "type": "integer",
            "title": "Last",
            "description": "Target of the last session started: the prefilled value."
          },
          "choices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Choices",
            "description": "Distinct targets of the last starts, shortest first."
          },
          "max_minutes": {
            "type": "integer",
            "title": "Max Minutes",
            "description": "Longest target allowed (ArbZG §3)."
          }
        },
        "type": "object",
        "required": [
          "last",
          "choices",
          "max_minutes"
        ],
        "title": "QuickTargetsOut"
      },
      "SessionOut": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "target_minutes": {
            "type": "integer",
            "title": "Target Minutes"
          },
          "required_break_minutes": {
            "type": "integer",
            "title": "Required Break Minutes",
            "description": "Break the law requires for the target (ArbZG §4). Pauses of at least 15 min (or the running one) count towards it; what is missing extends the end."
          },
          "pauses": {
            "items": {
              "$ref": "#/components/schemas/PauseOut"
            },
            "type": "array",
            "title": "Pauses",
            "description": "Past, running and planned pauses, by start."
          },
          "snoozed_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snoozed Until",
            "description": "Set once the one snooze is used: the alarm comes back then."
          },
          "legal_breaks": {
            "items": {
              "$ref": "#/components/schemas/LegalBreakOut"
            },
            "type": "array",
            "title": "Legal Breaks",
            "description": "ArbZG §4 rules, longest first, to preview a changed target."
          },
          "max_work_minutes": {
            "type": "integer",
            "title": "Max Work Minutes",
            "description": "At most this much work a day (ArbZG §3)."
          }
        },
        "type": "object",
        "required": [
          "started_at",
          "target_minutes",
          "required_break_minutes",
          "pauses",
          "snoozed_until",
          "legal_breaks",
          "max_work_minutes"
        ],
        "title": "SessionOut",
        "description": "Raw state; clients derive end time and countdown from it with their own clock."
      },
      "StartSession": {
        "properties": {
          "target_minutes": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Target Minutes",
            "description": "At most 10 h (ArbZG §3)."
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At",
            "description": "When work began, if earlier than now (at most 24 hours ago)."
          }
        },
        "type": "object",
        "required": [
          "target_minutes"
        ],
        "title": "StartSession"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
