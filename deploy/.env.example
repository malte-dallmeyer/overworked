# Server configuration for deploying from your machine. Copy to deploy/.env (not committed)
# and fill in. `node scripts/deploy.mjs` hands the values to the server as environment
# variables; the file itself stays here. GitHub Actions uses its own secrets instead.

# Image built by GitHub Actions, e.g. ghcr.io/<github user>/overworked:latest
OVERWORKED_IMAGE=
# Domain the DNS record points to; Caddy gets the certificate for it.
OVERWORKED_DOMAIN=

# App settings, see ../.env.example for all of them.
OVERWORKED_PASSWORD=
# openssl rand -hex 32
OVERWORKED_SECRET_KEY=
# A long random name, e.g. `openssl rand -hex 16`; subscribe to it in the ntfy app.
OVERWORKED_NTFY_TOPIC=
# Optional, for notifications in desktop browsers: `node scripts/generate-vapid-keys.mjs`
OVERWORKED_VAPID_PUBLIC_KEY=
OVERWORKED_VAPID_PRIVATE_KEY=
