# Copy to .env and adjust.

# Login. Required in the Docker image (it refuses to start without), optional for local
# development, where the API is open without a password.
OVERWORKED_PASSWORD=
# Signs the login cookie; at least 32 characters, e.g. `openssl rand -hex 32`.
# Changing it (or the password) logs out every device.
OVERWORKED_SECRET_KEY=

# Everything below is optional.

# ntfy server and topic for the alarm on your phone.
# Without a topic, alarms are only written to the log.
# On the public ntfy.sh anyone who knows the topic can read it: pick a long random name,
# e.g. `openssl rand -hex 16`.
OVERWORKED_NTFY_URL=https://ntfy.sh
OVERWORKED_NTFY_TOPIC=
# Access token, only needed if your ntfy server requires authentication.
OVERWORKED_NTFY_TOKEN=

# How often (seconds) the server checks whether an alarm is due.
OVERWORKED_ALARM_CHECK_INTERVAL_SECONDS=15

# Database. The Docker image defaults to sqlite:////data/overworked.db.
# OVERWORKED_DATABASE_URL=sqlite:///./data/overworked.db
